#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034 # USE_PROCD/START/STOP are consumed by /etc/rc.common
USE_PROCD=1
START=95
STOP=10

LIBDIR=/usr/libexec/trusttunnel
OUTDIR=/var/etc/trusttunnel
RECORDS=$OUTDIR/settings.tsv
CLIENT=/opt/trusttunnel_client/trusttunnel_client

# The operation mode of the APPLIED config: proxy (SOCKS5 listener) or
# tun. The records carry the UCI value; absent means tun — the default
# and the only mode of earlier versions.
mode_is_proxy() {
	[ "$(awk -F '\t' '$1 == "main.mode" { print $2; exit }' "$RECORDS" 2>/dev/null)" = "proxy" ]
}

# config_foreach callback: record the endpoint section whose name matches
# the active server reference (main.endpoint); other sections are skipped.
# shellcheck disable=SC2317,SC2154
_find_server() {
	_sec=$1
	_name=""
	config_get _name "$_sec" name
	[ "$_name" = "$server_want" ] || return 0
	server_sec="$_sec"
}

# resolve_active_server — populate server_sec with the section id of the
# ACTIVE server, or empty when main.endpoint is absent or stale. Requires
# a prior config_load trusttunnel; mirrors uci-export's resolution.
#
# The certificate and the verification override belong to the ACTIVE
# server only, and with repeatable endpoint sections the literal
# "endpoint" section name would read whichever section carries it, not
# the selected one — so every direct endpoint read goes through here.
resolve_active_server() {
	server_sec=""
	server_want=""
	config_get server_want main endpoint
	[ -n "$server_want" ] || return 0
	config_foreach _find_server endpoint
}

# Undo the keep-routing handshake of an interrupted restart: a start that
# aborted before the procd instance came up must tear the routing down for
# real, otherwise the table, the mark rule and the blackhole would stay
# hanging while nothing points at them.
teardown_hanging_routing() {
	[ "${_TT_KEEP_ROUTING:-0}" != "1" ] && return 0
	_TT_KEEP_ROUTING=0
	[ -f "$RECORDS" ] && "$LIBDIR/routing" down "$RECORDS"
	return 0
}

# Rebuild the applied-state records and the client configuration. The records
# file is replaced atomically (temp file + mv) so a reader never sees a
# half-written state; the pinned certificate and the generated config live
# next to it, both mode 0600.
regen_config() {
	umask 077
	mkdir -p "$OUTDIR" || return 1
	if ! "$LIBDIR/uci-export" > "$RECORDS.new"; then
		rm -f "$RECORDS.new"
		return 1
	fi
	mv "$RECORDS.new" "$RECORDS" || return 1

	# The pinned certificate belongs to the ACTIVE server; the read goes
	# through the same main.endpoint resolution as uci-export.
	config_load trusttunnel
	resolve_active_server
	_cert=""
	if [ -n "$server_sec" ]; then
		config_get _cert "$server_sec" certificate
	fi
	_cert_pem=""
	if [ -z "$_cert" ]; then
		rm -f "$OUTDIR/endpoint.pem"
	else
		printf '%s\n' "$_cert" > "$OUTDIR/endpoint.pem"
		chmod 0600 "$OUTDIR/endpoint.pem"
		# gen-config takes the pem FILE PATH, not the content: the
		# certificate is multi-line (never a record value) and is read
		# back from the file written just above.
		_cert_pem="$OUTDIR/endpoint.pem"
	fi

	# The pin argument is optional; an empty word must never reach the
	# command line, so it is expanded only while set.
	if ! "$LIBDIR/gen-config" "$RECORDS" ${_cert_pem:+"$_cert_pem"} > "$OUTDIR/client.toml"; then
		return 1
	fi
	chmod 0600 "$OUTDIR/client.toml"
	return 0
}

# Point the client at a CA bundle. A pinned certificate or disabled
# verification make the store unnecessary; otherwise the first existing
# non-empty bundle wins. The env vars are exported so the procd instance can
# pick them up later — an empty SSL_CERT_FILE must never reach the instance
# (an empty value is treated by the client as a broken lookup), which is why
# the variable is left unset when nothing was found.
provision_ca_store() {
	config_load trusttunnel
	resolve_active_server
	_skipver=0
	_pinned=""
	if [ -n "$server_sec" ]; then
		config_get_bool _skipver "$server_sec" skip_verification 0
		config_get _pinned "$server_sec" certificate
	fi
	# shellcheck disable=SC2154 # both are assigned by config_get_bool/config_get above
	if [ "${_skipver:-0}" = "1" ] || [ -n "${_pinned:-}" ]; then
		return 0
	fi
	for _cafile in /etc/ssl/cert.pem /etc/ssl/certs/ca-certificates.crt; do
		[ -s "$_cafile" ] || continue
		export SSL_CERT_FILE="$_cafile"
		[ -d /etc/ssl/certs ] && export SSL_CERT_DIR=/etc/ssl/certs
		return 0
	done
	logger -t trusttunnel "fatal: no CA bundle on the system — install ca-bundle, pin a certificate, or turn off verification"
	return 1
}

start_service() {
	config_load trusttunnel
	config_get_bool enabled main enabled 0
	# shellcheck disable=SC2154 # assigned by config_get_bool above
	# main.enabled means "start on boot": it gates the automatic starts
	# (boot, the wan-up trigger, a config reload), but an EXPLICIT start
	# from the Status page (TT_START_NOW, set by the rpcd backend's
	# service method) must run the tunnel now even while the service is
	# disabled for boot.
	if [ "$enabled" != "1" ] && [ "${TT_START_NOW:-0}" != "1" ]; then
		logger -t trusttunnel "service is disabled in the configuration; not starting"
		teardown_hanging_routing
		return 0
	fi
	if [ ! -x "$CLIENT" ]; then
		logger -t trusttunnel "error: the client binary is missing at $CLIENT; run install.sh"
		teardown_hanging_routing
		return 1
	fi
	if ! provision_ca_store; then
		teardown_hanging_routing
		return 1
	fi
	if ! regen_config; then
		logger -t trusttunnel "error: failed to generate the records and the client config"
		teardown_hanging_routing
		return 1
	fi
	await_default_route
	await_clock
	# Tun mode wires the kernel routing first (a hard prerequisite, the
	# client would blackhole DNS otherwise) and remembers the newest
	# existing tun index before the client creates its own device, so the
	# attach below only ever touches the fresh one. Proxy mode needs no
	# routing: the client binds the SOCKS listener itself, and the usage
	# meter (byte counters on the listener port) is a nicety — a failed
	# meter must not take the tunnel down with it.
	if mode_is_proxy; then
		_tun_since=0
		if ! "$LIBDIR/routing" meter "$RECORDS" "$OUTDIR"; then
			logger -t trusttunnel "warning: usage metering is not active"
		fi
	else
		if ! "$LIBDIR/routing" up "$RECORDS" "$OUTDIR"; then
			logger -t trusttunnel "error: routing setup failed"
			teardown_hanging_routing
			return 1
		fi
		_tun_since=$(highest_ifindex)
	fi

	procd_open_instance trusttunnel
	procd_set_param command "$CLIENT" -c "$OUTDIR/client.toml"
	set_procd_env
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	# The pidfile is an explicit contract: the integration harness and the
	# diagnostics read /var/run/trusttunnel.pid, and procd writes no
	# pidfile unless one is configured.
	procd_set_param pidfile /var/run/trusttunnel.pid
	procd_close_instance

	if [ "$_tun_since" -gt 0 ]; then
		attach_client_tun "$_tun_since" || true
	fi
	return 0
}

stop_service() {
	if [ "${_TT_KEEP_ROUTING:-0}" != "1" ] && [ -f "$RECORDS" ]; then
		"$LIBDIR/routing" down "$RECORDS"
	fi
	return 0
}

# Export the trust-store variables to the instance, but only when they were
# actually found: an empty SSL_CERT_FILE would be treated by the client as a
# broken lookup. The dir variable is only exported alongside a non-empty
# file variable.
set_procd_env() {
	[ -n "${SSL_CERT_FILE:-}" ] || return 0
	if [ -n "${SSL_CERT_DIR:-}" ]; then
		procd_set_param env SSL_CERT_FILE="$SSL_CERT_FILE" SSL_CERT_DIR="$SSL_CERT_DIR"
	else
		procd_set_param env SSL_CERT_FILE="$SSL_CERT_FILE"
	fi
}

# The client validates the server certificate against the wall clock, so a
# freshly flashed router whose clock is still in the past would fail every
# handshake. Give the clock up to 30 s to catch up with the install time;
# the mtime of gen-config marks it, with a floor for filesystems that do not
# carry one.
await_clock() {
	_floor=$(date -r "$LIBDIR/gen-config" +%s 2>/dev/null) || _floor=1750000000
	_elapsed=0
	while [ "$(date +%s)" -lt "$_floor" ] && [ "$_elapsed" -lt 30 ]; do
		sleep 2
		_elapsed=$((_elapsed + 2))
	done
	if [ "$(date +%s)" -lt "$_floor" ]; then
		logger -t trusttunnel "warning: the clock is still behind the install time; certificate validation may fail"
	fi
	return 0
}

# A default route is needed before routing setup can do anything useful.
# Missing it is not fatal by itself — the wan may still come up right after
# the service starts — so this only warns.
await_default_route() {
	_elapsed=0
	while [ -z "$(ip route show default 2>/dev/null)" ] && [ "$_elapsed" -lt 30 ]; do
		sleep 1
		_elapsed=$((_elapsed + 1))
	done
	if [ -z "$(ip route show default 2>/dev/null)" ]; then
		logger -t trusttunnel "warning: no default route after 30s"
	fi
	return 0
}

# The highest interface index currently known. Entries that are gone or whose
# index is unreadable are skipped; with no interfaces at all the answer is 0.
highest_ifindex() {
	_max=0
	for _dev in /sys/class/net/*; do
		[ -f "$_dev/ifindex" ] || continue
		_idx=$(cat "$_dev/ifindex" 2>/dev/null) || continue
		case "$_idx" in
			''|*[!0-9]*) continue ;;
		esac
		if [ "$_idx" -gt "$_max" ]; then
			_max=$_idx
		fi
	done
	echo "$_max"
}

# Tun devices created after <since> that belong to the client: a tun_flags
# marker, an index above the snapshot, and the IFF_PERSIST bit (0x800) clear —
# persistent tuns are not owned by the running client.
fresh_client_tuns() {
	_since=$1
	for _dev in /sys/class/net/*; do
		[ -f "$_dev/tun_flags" ] || continue
		_flags=$(cat "$_dev/tun_flags" 2>/dev/null) || continue
		_idx=$(cat "$_dev/ifindex" 2>/dev/null) || continue
		[ "$_idx" -gt "$_since" ] || continue
		if [ $((_flags & 0x800)) -eq 0 ]; then
			echo "${_dev##*/}"
		fi
	done
}

# Attach the first client tun created after <since>, waiting for it to
# appear: the client creates its device asynchronously after spawn, and a
# single attempt loses the race whenever the device is not there yet.
# The hotplug hook is the fallback for later recreations, but its add
# event can be skipped during a restart (the service's running state is
# in flux), so the start path must not depend on it. The bound is short —
# a healthy client's device appears within a second.
attach_client_tun() {
	_new=""
	_i=0
	while [ "$_i" -lt 10 ]; do
		_i=$((_i + 1))
		_new=$(fresh_client_tuns "$1" | head -n 1)
		[ -n "$_new" ] && break
		sleep 1
	done
	[ -n "$_new" ] || return 0
	"$LIBDIR/routing" attach "$RECORDS" "$OUTDIR" "$_new"
}

# Keys whose multiset of values differs between two records files — or
# whose list values were REORDERED. List options repeat their key, so the
# comparison must count occurrences of every key/value pair: a second list
# entry under an existing key is a change, and so is a scalar value swap.
# Order matters too: uci-export emits list options in UCI order (the
# endpoint address list is ordered by design), and a pure permutation
# leaves the multiset identical while the client keeps the old config, so
# a key whose value sequence differs is reported as well. Keys are the
# text before the first tab; the output is sorted and deduplicated.
diff_keys() {
	awk -F '\t' '
		NR == FNR {
			n[$1 FS $2]++
			seq1[$1, ++cnt1[$1]] = $2
			next
		}
		{
			m[$1 FS $2]++
			seq2[$1, ++cnt2[$1]] = $2
		}
		END {
			for (p in n) if (!(p in m) || m[p] != n[p]) { split(p, a, FS); print a[1] }
			for (p in m) if (!(p in n)) { split(p, a, FS); print a[1] }
			for (k in cnt1) if (k in cnt2 && cnt1[k] == cnt2[k]) {
				for (i = 1; i <= cnt1[k]; i++)
					if (seq1[k, i] != seq2[k, i]) { print k; break }
			}
		}
	' "$1" "$2" | sort -u
}

# The cheapest action that still applies a key correctly. Everything unknown
# gets the fullest action: a too-cheap guess leaves the UI showing a setting
# that is not in effect, which is impossible to diagnose.
class_for_key() {
	case "$1" in
		network.lan_devices|network.blackhole_on_down|network.include_router_traffic)
			echo "reload"
			;;
		network.table|network.fwmark|main.enabled|main.mode)
			echo "restart_full"
			;;
		domains.direct|main.log_level|network.mtu|endpoint.*|routing_profile.*|proxy.*)
			echo "restart"
			;;
		*)
			echo "restart_full"
			;;
	esac
}

rank_of_class() {
	case "$1" in
		noop) echo 0 ;;
		reload) echo 1 ;;
		restart) echo 2 ;;
		*) echo 3 ;;
	esac
}

max_class() {
	if [ "$(rank_of_class "$1")" -ge "$(rank_of_class "$2")" ]; then
		echo "$1"
	else
		echo "$2"
	fi
}

# The class of the whole apply: the most expensive key decides.
class_of_diff() {
	_class=noop
	for _key in $(diff_keys "$1" "$2"); do
		_class=$(max_class "$_class" "$(class_for_key "$_key")")
	done
	echo "$_class"
}

# The service is restarted with SIGTERM blocked: the stop inside must not be
# interrupted while the routing survives the cycle.
# shellcheck disable=SC2119,SC2120 # rc.common and apply_config call restart without arguments
restart() {
	trap '' TERM
	stop "$@"
	start "$@"
}

reload_service() {
	apply_config
}

# Save & Apply. Decides between doing nothing, reloading routing only, and
# restarting the client with or without a routing teardown. The certificate
# never lands in the records (it is multi-line), so it is compared through
# the separate pem file.
apply_config() {
	if [ ! -f "$RECORDS" ] || ! running; then
		restart
		return $?
	fi

	umask 077
	if ! "$LIBDIR/uci-export" > "$RECORDS.next"; then
		rm -f "$RECORDS.next"
		logger -t trusttunnel "warning: could not export the settings; falling back to a full restart"
		restart
		return $?
	fi

	_class=$(class_of_diff "$RECORDS" "$RECORDS.next")
	config_load trusttunnel
	resolve_active_server
	_cert_uci=""
	if [ -n "$server_sec" ]; then
		config_get _cert_uci "$server_sec" certificate
	fi
	_cert_pem=$(cat "$OUTDIR/endpoint.pem" 2>/dev/null)
	if [ "$_cert_uci" != "$_cert_pem" ]; then
		_class=$(max_class "$_class" restart)
	fi

	case "$_class" in
		noop)
			mv "$RECORDS.next" "$RECORDS"
			logger -t trusttunnel "settings applied: no changes needed for these keys"
			;;
		reload)
			rm -f "$RECORDS.next"
			# The reload-class keys are tun-mode routing options; in proxy
			# mode nothing is rebuilt (regen_config below still applies
			# the new records), and in tun mode the routing must come up
			# before the client is told to keep running.
			if ! regen_config; then
				logger -t trusttunnel "warning: the no-restart path failed; restarting the service"
				restart
			elif mode_is_proxy || { "$LIBDIR/routing" up "$RECORDS" "$OUTDIR" && "$LIBDIR/routing" reattach "$RECORDS" "$OUTDIR"; }; then
				logger -t trusttunnel "settings applied without a client restart"
			else
				logger -t trusttunnel "warning: the no-restart path failed; restarting the service"
				restart
			fi
			;;
		restart)
			rm -f "$RECORDS.next"
			_TT_KEEP_ROUTING=1
			restart
			;;
		*)
			rm -f "$RECORDS.next"
			restart
			;;
	esac
}

# Procd hooks: a UCI change reloads the service (which lands in
# apply_config), and a wan interface coming up restarts it so the tunnel
# follows the network.
service_triggers() {
	procd_add_reload_trigger "trusttunnel"
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/trusttunnel restart
}
