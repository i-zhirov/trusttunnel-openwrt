#!/bin/sh
# First-boot setup: repair the trusttunnel firewall zone and seed the
# default routing profile on upgraded installs.
# shellcheck disable=SC1091
. /lib/functions.sh

# Keep the first zone named trusttunnel and drop the later duplicates.
# The callback is invoked indirectly by config_foreach from the OpenWrt
# shell library, so shellcheck cannot see the call sites.
# shellcheck disable=SC2329,SC2154
_dedup_zone() {
	_dz_sec=$1
	config_get _dz_name "$_dz_sec" name
	[ "$_dz_name" = "trusttunnel" ] || return 0
	if [ -z "$_zone_sec" ]; then
		_zone_sec=$_dz_sec
	else
		uci delete "firewall.$_dz_sec"
		_removed=1
	fi
}

# Keep the first forwarding that targets trusttunnel and drop the rest.
# shellcheck disable=SC2329,SC2154
_dedup_forwarding() {
	_df_sec=$1
	config_get _df_dest "$_df_sec" dest
	[ "$_df_dest" = "trusttunnel" ] || return 0
	if [ -z "$_fwd_sec" ]; then
		_fwd_sec=$_df_sec
	else
		uci delete "firewall.$_df_sec"
		_removed=1
	fi
}

# Mark the presence of a routing profile; the seed block only fires when
# the callback never runs.
# shellcheck disable=SC2329
_count_profiles() {
	_has_profile=1
}

_zone_sec=""
_fwd_sec=""
_removed=""

config_load firewall
config_foreach _dedup_zone zone
config_foreach _dedup_forwarding forwarding

if [ -n "$_removed" ]; then
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	logger -t trusttunnel "cleaned up duplicate trusttunnel firewall zones"
fi

# Create the zone and its forwarding when no trusttunnel zone exists. The
# zone carries NO device binding: it is inert until the routing helper
# attaches a concrete tun device (a tun+ wildcard would absorb foreign tun
# devices like OpenVPN's).
if [ -z "$_zone_sec" ]; then
	_new_zone=$(uci add firewall zone)
	uci set "firewall.$_new_zone.name"='trusttunnel'
	uci set "firewall.$_new_zone.input"='REJECT'
	uci set "firewall.$_new_zone.output"='ACCEPT'
	uci set "firewall.$_new_zone.forward"='REJECT'
	uci set "firewall.$_new_zone.masq"='1'
	uci set "firewall.$_new_zone.mtu_fix"='1'
	_new_fwd=$(uci add firewall forwarding)
	uci set "firewall.$_new_fwd.src"='lan'
	uci set "firewall.$_new_fwd.dest"='trusttunnel'
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
fi

# Migrate the zone to the device-less shape: old versions bound it to tt0
# or to the tun+ wildcard, both of which claim devices that are not the
# client's. The routing helper re-binds the concrete device on attach. A
# binding that equals the CURRENTLY attached device (recorded by the
# routing helper) is left alone: install.sh re-runs this script while a
# running service is attached, and clearing the live binding would cut
# the tunnel's firewall path.
_migrated=""
if [ -n "$_zone_sec" ]; then
	# _devs comes from config_get, which shellcheck cannot trace.
	config_get _devs "$_zone_sec" device
	# shellcheck disable=SC2154
	if [ -n "$_devs" ]; then
		_attached=$(cat /var/etc/trusttunnel/device 2>/dev/null) || _attached=""
		_keep=0
		for _d in $_devs; do
			[ "$_d" = "$_attached" ] && _keep=1
		done
		if [ "$_keep" = "0" ]; then
			uci -q delete "firewall.$_zone_sec.device"
			_migrated=1
		fi
	fi
	# After a dedup there is nothing left to repair here: the pass kept
	# the first trusttunnel zone and deleted the rest, so the surviving
	# zone is exactly the one the migration block above just unbound.
	# There is deliberately no rebind pass over all remaining zones — one
	# that ran without a name check used to rewrite the device list of
	# every unrelated zone after the first one in file order (a stock wan
	# zone lost its binding and gained tun+).
fi
if [ -n "$_migrated" ]; then
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	logger -t trusttunnel "firewall zone unbound; the attached tun device is bound on start"
fi

# Seed the default routing profile on installs that predate it: create the
# profile and point the endpoint at it. A legacy install WITH a
# domains.direct list keeps its full-tunnel behaviour — vpn mode with the
# old direct list moved into the bypass rules. Without a direct list the
# new direct-by-default default applies: bypass mode routes nothing until
# the user adds VPN rules.
_has_profile=""
config_load trusttunnel
config_foreach _count_profiles routing_profile

if [ -z "$_has_profile" ]; then
	_prof=$(uci add trusttunnel routing_profile)
	uci set "trusttunnel.$_prof.name"='Default'
	_direct_count=0
	while IFS= read -r _d; do
		[ -n "$_d" ] || continue
		uci add_list "trusttunnel.$_prof.bypass_rules"="$_d"
		_direct_count=$((_direct_count + 1))
	done <<EOF
$(uci -q get trusttunnel.domains.direct 2>/dev/null)
EOF
	if [ "$_direct_count" -gt 0 ]; then
		uci set "trusttunnel.$_prof.mode"='vpn'
		uci commit trusttunnel
		logger -t trusttunnel "created the default routing profile; the old direct list moved into its bypass rules"
	else
		uci set "trusttunnel.$_prof.mode"='bypass'
		uci commit trusttunnel
		logger -t trusttunnel "created the default routing profile in bypass mode; traffic goes out directly until rules route it"
	fi
	uci set trusttunnel.endpoint.routing_profile='Default'
	uci commit trusttunnel
fi

# Seed the active-server selection on installs that predate it, and heal
# a stale reference: the endpoint sections are repeatable now and
# main.endpoint names the ACTIVE one. A pre-feature config carries
# exactly one endpoint section without a `name`; give it the Default name
# (or keep an existing one) and select it. A selector that names no
# section (a server renamed or deleted outside the UI) is re-pointed at
# the first remaining server. Configs that already select a server —
# including the shipped default — are left alone.
# shellcheck disable=SC2329,SC2154
_find_first_endpoint() {
	[ -n "$_first_endpoint_sec" ] && return 0
	_first_endpoint_sec=$1
}

# config_foreach callback: mark when an endpoint section matches the
# active server reference; the stale-reference heal needs to know whether
# the reference still resolves.
# shellcheck disable=SC2329,SC2154
_find_named_endpoint() {
	_sec=$1
	_name=""
	config_get _name "$_sec" name
	[ "$_name" = "$_active_server" ] || return 0
	_server_matches=1
}

_first_endpoint_sec=""
config_foreach _find_first_endpoint endpoint
config_get _active_server main endpoint
_server_matches=""
if [ -n "$_active_server" ]; then
	config_foreach _find_named_endpoint endpoint
fi
if { [ -z "$_active_server" ] || [ -z "$_server_matches" ]; } && [ -n "$_first_endpoint_sec" ]; then
	_name=""
	config_get _name "$_first_endpoint_sec" name
	[ -n "$_name" ] || {
		uci set "trusttunnel.$_first_endpoint_sec.name"='Default'
		_name="Default"
	}
	# uci set cannot create a section, so a missing main section (a
	# minimal pre-feature config) is created first.
	if ! uci -q get trusttunnel.main >/dev/null 2>&1; then
		uci set trusttunnel.main='main'
	fi
	uci set trusttunnel.main.endpoint="$_name"
	uci commit trusttunnel
	logger -t trusttunnel "selected the $_name endpoint as the active server"
fi

# Seed the proxy section on installs that predate proxy mode, so the Proxy
# tab always renders the listener defaults. The operation mode itself
# stays absent (tun) — an upgrade must not silently change delivery.
if ! uci -q get trusttunnel.proxy >/dev/null 2>&1; then
	uci set trusttunnel.proxy='proxy'
	uci set trusttunnel.proxy.address='127.0.0.1:1080'
	uci commit trusttunnel
	logger -t trusttunnel "created the proxy section with the default listener address"
fi

# Finalize: register the rc.d link so the service starts on boot (the
# enabled flag is only consulted inside start_service) and clear the LuCI
# caches.
/etc/init.d/trusttunnel enable >/dev/null 2>&1
for _luci_cache in /tmp/luci-indexcache /tmp/luci-modulecache; do
	rm -rf "$_luci_cache" 2>/dev/null
done
exit 0
