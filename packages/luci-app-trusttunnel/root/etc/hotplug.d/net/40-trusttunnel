#!/bin/sh
# Net hotplug hook: reattach the tunnel route when the client recreates its
# tun device, and tear the attached route down when that device goes away.
# Runs once per net event; every event this hook does not act on must exit 0.
#
# Add events: the device must be a tun (sysfs tun_flags marker), must not
# be persistent (the IFF_PERSIST bit — persistent tuns are created manually
# or left behind by old package versions, never by the client), and must be
# NEWER than the service's ifindex snapshot: the snapshot (written by the
# init script right before the client starts) is how the client's own
# devices are told apart from foreign tun devices (OpenVPN and friends).
#
# Remove/unbind events: when the event names the recorded attached device,
# the tunnel is gone. The detach drops the blackhole in the default
# fail-open mode (marked traffic falls through to the direct route) and
# keeps it armed in strict mode (the killswitch keeps protecting the
# tunneled set); either way the next add event re-attaches.

# The event names the device in INTERFACE, with DEVICENAME as the fallback.
# Without a device name there is nothing to act on.
dev="${INTERFACE:-$DEVICENAME}"
[ -n "$dev" ] || exit 0

# The route is attached from the records written by the service; without the
# records file there is nothing to attach.
RECORDS=/var/etc/trusttunnel/settings.tsv
OUTDIR=/var/etc/trusttunnel
[ ! -f "$RECORDS" ] && exit 0

# The tun reattach dance is tun-mode only: in proxy mode the client binds a
# SOCKS listener and no tun device or routing table exists to attach.
[ "$(awk -F '\t' '$1 == "main.mode" { print $2; exit }' "$RECORDS" 2>/dev/null)" = "proxy" ] && exit 0

# A remove/unbind of the recorded attached device: the tunnel device is
# gone, so detach — the blackhole dies with it and marked traffic falls
# through to the direct route until the client recreates the device (the
# add event below re-arms). The sysfs checks are deliberately skipped here:
# during a remove event the device directory may already be gone.
case "$ACTION" in
	remove|unbind)
		cur=$(cat "$OUTDIR/device" 2>/dev/null)
		[ -n "$cur" ] && [ "$cur" = "$dev" ] || exit 0
		/usr/libexec/trusttunnel/routing detach "$RECORDS" "$OUTDIR"
		exit $?
		;;
	*) ;;
esac

# Only add events reach this point; anything else is not ours to act on.
[ "$ACTION" = "add" ] || exit 0

# Only tun/tap devices expose tun_flags in sysfs; a device without the file
# is a regular net device and cannot carry the tunnel route.
[ -e "/sys/class/net/$dev/tun_flags" ] || exit 0

# Read the flags word; when the read fails there is no way to classify the
# device, so the event is ignored. The IFF_PERSIST bit (0x800) marks manual
# and legacy devices: skip them, only the client-created non-persistent tun
# device triggers the reattach.
flags=$(cat "/sys/class/net/$dev/tun_flags" 2>/dev/null) || exit 0
[ "$((flags & 0x800))" = "0" ] || exit 0

# Only a running service may reattach; a stopped one must not touch routing.
/etc/init.d/trusttunnel running >/dev/null 2>&1 || exit 0

# The client's own devices are created after the service start: the init
# script records the highest ifindex that existed before the client ran.
# An event device at or below that snapshot was created by somebody else
# and must never be attached.
idx=$(cat "/sys/class/net/$dev/ifindex" 2>/dev/null) || exit 0
case "$idx" in
	''|*[!0-9]*) exit 0 ;;
esac
since=$(cat "$OUTDIR/tun_since" 2>/dev/null) || since=""
if [ -n "$since" ] && [ "$idx" -le "$since" ] 2>/dev/null; then
	exit 0
fi

# The device recorded as currently attached belongs to a working tunnel.
# When it still exists in sysfs and the event names a different device, the
# event is foreign: reattaching would tear the working tunnel off.
cur=$(cat "$OUTDIR/device" 2>/dev/null)
if [ -n "$cur" ]; then
	if [ -d "/sys/class/net/$cur" ] && [ "$cur" != "$dev" ]; then
		exit 0
	fi
fi

# Every guard passed: reattach the route to the event device. The log line is
# emitted only when the attach succeeded, and the hook's exit status follows
# the attach outcome.
/usr/libexec/trusttunnel/routing attach "$RECORDS" "$OUTDIR" "$dev" &&
	logger -t trusttunnel "hotplug: reattached routing to $dev"
