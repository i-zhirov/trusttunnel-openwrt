#!/bin/sh
# Generate the client.toml for the TrustTunnel client binary.
#
# Usage: gen-config <records-file> [pem-file]
#
# The records file is the tab-separated settings dump produced by
# uci-export (see records.sh). The output is the client configuration:
# the field set, values, order and formatting are a fixed contract, so
# every key is emitted exactly as documented below and nothing else.
#
# The routing profile resolution mirrors the GUI: the assigned profile
# is resolved by name into routing_profile.* records. A bypass-mode
# profile tunnels only its vpn_rules; a vpn-mode profile tunnels
# everything except its bypass_rules. Anything else (no assignment, a
# stale name, an unknown mode) falls back to the direct-by-default
# rule in tun mode: selective mode with nothing tunneled, so traffic
# goes out directly unless explicitly routed. Proxy mode keeps the
# legacy general+domains.direct fallback: pointing an app at the SOCKS
# listener IS the explicit routing there, so the proxy keeps tunneling
# everything except the legacy direct list.
#
# The operation mode (main.mode, default tun) picks the listener block:
# tun mode emits [listener.tun] with the routing owned by the package,
# proxy mode emits [listener.socks] instead. The client accepts exactly
# one listener, so the blocks are mutually exclusive by construction.

set -u

# The library directory defaults to the script's own location; callers
# may override it via TT_LIBDIR.
TT_LIBDIR="${TT_LIBDIR:-$(dirname "$0")}"
. "$TT_LIBDIR/records.sh"

TT_RECORDS=${1:?usage: gen-config <records-file> [pem-file]}

# tt_esc <value> — print the value escaped for a TOML basic string:
# backslashes first, then double quotes. sed, not awk: the awk gsub
# replacement semantics differ between gawk and BSD awk for backslashes
# (gawk follows POSIX and halves them, BSD awk does not), while sed's
# replacement behaves identically everywhere.
tt_esc() {
    printf '%s\n' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# tt_array <key> — print every record for the key as one TOML array:
# each item escaped like a scalar, items joined with ", " inside square
# brackets; an absent key renders the empty array.
tt_array() {
    # Each item escaped like a scalar; sed for the same portability
    # reason as tt_esc.
    tt_list "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk 'BEGIN { printf "[" }
        {
            if (item++) printf ", "
            printf "\"%s\"", $0
        }
        END { printf "]\n" }'
}

# Mandatory records: the endpoint identity and at least one address.
for tt_key in endpoint.hostname endpoint.username endpoint.password; do
    if [ -z "$(tt_get "$tt_key")" ]; then
        printf 'gen-config: %s is not set\n' "$tt_key" >&2
        exit 1
    fi
done
if [ "$(tt_count endpoint.address)" -lt 1 ]; then
    printf 'gen-config: endpoint.address is not set\n' >&2
    exit 1
fi

# Resolve the routing profile for vpn_mode and the exclusion list. The
# mode is consulted only when a profile is assigned by name; any other
# situation takes the fallback branch.
tt_profile=$(tt_get endpoint.routing_profile)
tt_mode=
if [ -n "$tt_profile" ] && [ "$tt_profile" = "$(tt_get routing_profile.name)" ]; then
    tt_mode=$(tt_get routing_profile.mode)
fi
case $tt_mode in
    bypass)
        tt_vpn_mode=selective
        tt_exclusions_key=routing_profile.vpn_rules
        ;;
    vpn)
        tt_vpn_mode=general
        tt_exclusions_key=routing_profile.bypass_rules
        ;;
    *)
        # The direct-by-default fallback: no profile (or a stale name or
        # an unknown mode) must not sweep traffic into the tunnel. In tun
        # mode nothing is routed unless a profile explicitly says so — an
        # absent vpn_rules key yields the empty exclusions list. In proxy
        # mode the app itself is the explicit routing, so the legacy
        # full-tunnel semantics (everything except domains.direct) stay.
        if [ "$(tt_get main.mode)" = "proxy" ]; then
            tt_vpn_mode=general
            tt_exclusions_key=domains.direct
        else
            tt_vpn_mode=selective
            tt_exclusions_key=routing_profile.vpn_rules
        fi
        ;;
esac

# Top-level block.
printf '# Generated by luci-app-trusttunnel. Do not edit: changes are overwritten.\n'
printf 'loglevel = "%s"\n' "$(tt_esc "$(tt_get main.log_level info)")"
printf 'vpn_mode = "%s"\n' "$tt_vpn_mode"
printf 'killswitch_enabled = false\n'
printf 'post_quantum_group_enabled = %s\n' "$(tt_bool endpoint.post_quantum 1)"
printf 'exclusions_tcp_early_ack_enabled = true\n'
printf 'exclusions_preresolve_enabled = true\n'
printf 'exclusions = %s\n' "$(tt_array "$tt_exclusions_key")"

# Endpoint block.
printf '\n[endpoint]\n'
printf 'hostname = "%s"\n' "$(tt_esc "$(tt_get endpoint.hostname)")"
printf 'addresses = %s\n' "$(tt_array endpoint.address)"
printf 'has_ipv6 = %s\n' "$(tt_bool endpoint.has_ipv6 1)"
printf 'username = "%s"\n' "$(tt_esc "$(tt_get endpoint.username)")"
printf 'password = "%s"\n' "$(tt_esc "$(tt_get endpoint.password)")"
printf 'custom_sni = "%s"\n' "$(tt_esc "$(tt_get endpoint.custom_sni)")"
printf 'client_random = "%s"\n' "$(tt_esc "$(tt_get endpoint.client_random)")"
printf 'skip_verification = %s\n' "$(tt_bool endpoint.skip_verification)"
if [ "$#" -gt 1 ] && [ -s "$2" ]; then
    # Multi-line literal: the file content normalized so the closing
    # delimiter always starts on its own line.
    # The literal delimiters in double quotes: the \x27 hex escape is
    # not portable across printf implementations (bash yes, dash no).
    printf "certificate = '''\n"
    awk 1 "$2"
    printf "'''\n"
else
    printf 'certificate = ""\n'
fi
printf 'upstream_protocol = "%s"\n' "$(tt_esc "$(tt_get endpoint.protocol http2)")"
printf 'anti_dpi = %s\n' "$(tt_bool endpoint.anti_dpi)"
printf 'dns_upstreams = %s\n' "$(tt_array endpoint.dns_upstream)"

# Listener block: exactly one of the two — the client rejects a config
# that declares both or neither. Tun mode (the default) keeps the kernel
# routing owned by the package; proxy mode binds a SOCKS5 listener whose
# address and optional auth come from the proxy records.
if [ "$(tt_get main.mode)" = "proxy" ]; then
	printf '\n[listener.socks]\n'
	printf 'address = "%s"\n' "$(tt_esc "$(tt_get proxy.address 127.0.0.1:1080)")"
	# Auth is an on/off pair: a username without a password (or vice
	# versa) would make the client demand credentials nobody knows, so
	# both sides are emitted only when the username is set.
	if [ -n "$(tt_get proxy.username)" ]; then
		printf 'username = "%s"\n' "$(tt_esc "$(tt_get proxy.username)")"
		printf 'password = "%s"\n' "$(tt_esc "$(tt_get proxy.password)")"
	fi
else
	printf '\n[listener.tun]\n'
	printf 'included_routes = []\n'
	printf 'excluded_routes = []\n'
	printf 'mtu_size = %s\n' "$(tt_get network.mtu 1350)"
	printf 'change_system_dns = false\n'
fi
