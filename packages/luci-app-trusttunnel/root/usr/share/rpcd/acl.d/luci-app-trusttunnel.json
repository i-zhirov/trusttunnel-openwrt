{
	"luci-app-trusttunnel": {
		"description": "Access to the TrustTunnel settings, diagnostics and service control",
		"read": {
			"ubus": {
				"luci.trusttunnel": [
					"check_domain", "diagnose", "log", "ping", "probe", "status", "versions"
				]
			},
			"uci": [ "trusttunnel" ]
		},
		"write": {
			"ubus": {
				"luci.trusttunnel": [ "import_config", "service" ]
			},
			"uci": [ "trusttunnel" ]
		}
	}
}
